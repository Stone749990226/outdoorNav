Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
    Cell Size: 1
    Color: 120; 120; 120
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/TF
    Enabled: true
    Name: TF
    Show Names: false
    Marker Scale: 0.6
    Frame Timeout: 15
  - Class: rviz_default_plugins/RobotModel
    Enabled: true
    Name: RobotModel
    Description Topic:
      Value: /robot_description
    Visual Enabled: true
    Links:
      rtk_marker_link:
        Alpha: 0
        Show Axes: false
        Show Trail: false
        Visible: false
  - Class: rviz_default_plugins/Odometry
    Enabled: true
    Name: RobotPose（车在哪）
    Topic:
      Value: /odometry/global
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Keep: 1
    Position Tolerance: 0.1
    Angle Tolerance: 0.2
    Shape:
      Alpha: 1
      Axes Length: 4
      Axes Radius: 0.3
      Color: 255; 80; 0
      Head Length: 1.4
      Head Radius: 0.5
      Shaft Length: 4
      Shaft Radius: 0.22
    Covariance:
      Position:
        Alpha: 0
      Orientation:
        Alpha: 0
  - Class: rviz_default_plugins/Map
    Enabled: true
    Name: GlobalCostmap-nav2
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Alpha: 0.6
    Color Scheme: map
    Draw Behind: false
    Update Topic:
      Value: /global_costmap/costmap_updates
  - Class: rviz_default_plugins/Map
    Enabled: true
    Name: LocalCostmap-nav2
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Alpha: 0.7
    Color Scheme: costmap
    Draw Behind: false
    Update Topic:
      Value: /local_costmap/costmap_updates
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: PlanPath
    Topic:
      Value: /rtk/plan_path
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Color: 0; 255; 0
    Line Style: Lines
    Line Width: 0.03
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: RGB
    Max Value: 1
    Min Value: 0
    Topic:
      Value: /rtk/camera/image
      Depth: 5
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Depth
    Max Value: 1
    Min Value: 0
    Topic:
      Value: /rtk/camera/depth_display
      Depth: 5
      Reliability Policy: Best Effort
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 7
      Target Frame: <Fixed Frame>
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Height: 800
  Width: 1200
