#!/bin/bash
# window_capture.sh —— WSLg 下按【窗口】截图，并**判定这张图是不是真的截到了** ✓
#
# ★ 为什么要有它（2026-10-10 实测教训 ✓）：
#   ★ WSLg 下**全屏**截图三条路全不通 ✗ —— `import -window root` 报错 ✗、
#     `xwd -root` ⇒ `BadMatch (X_GetImage)` ✗、`ffmpeg -f x11grab` ⇒
#     ★ **出图了但整张全黑**（mean=1.5889 ✓）✗。
#   ⇒ ★★ **"出图了" ≠ "截到了"** ✗ ⇒ 判据必须是**亮度**，✗ 不是"文件存在" ✗。
#   ★ 而**逐窗**这条通 ✓：`xwd -id <id>` ＋ `convert` ⇒ 真画面 ✓。
#
# ★ 列窗口用 `xwininfo -root -tree` ✗ 不用 `wmctrl -l` ✗（本机 Weston 不提供 `_NET_CLIENT_LIST` ✓）。
#
# 用法: window_capture.sh <输出目录> [名字正则] [最少窗口数]
#   ★ 名字正则默认匹配 gazebo|rviz|ign ；★ 最少窗口数默认 1
#   ★ 判据: ① 找到的窗口数 ≥ 最少窗口数 ✓  ② 每张图**亮度均值 ≥ 阈值** ✓
#   ★ 退出码: 0 = 两条都过 ｜ 1 = 有条不过 ｜ 2 = 用法错/环境不可用
set -u

OUT="${1:?用法: window_capture.sh <输出目录> [名字正则] [最少窗口数]}"
PAT="${2:-gazebo|rviz|ign}"
MIN="${3:-1}"
THRESH=1000          # ★ 亮度阈值（0..65535）。实测: 真画面 64114 ✓ ／ 全黑图 1.6 ✗
mkdir -p "$OUT"

command -v xwininfo >/dev/null || { echo "✗ 没有 xwininfo"; exit 2; }
command -v xwd >/dev/null || { echo "✗ 没有 xwd（在 x11-apps 里）"; exit 2; }
command -v convert >/dev/null || { echo "✗ 没有 convert"; exit 2; }

echo "=== 1. 列窗口（xwininfo -root -tree ✓，按名字正则筛）==="
TREE=$(xwininfo -root -tree 2>/dev/null)
echo "$TREE" | command grep -iE '0x[0-9a-f]+ ' | sed 's/^/  /' | head -25

# ★★ 抽窗口 id：★ 用 **字段**（$1）＋ **锚定** `^...$` ✓
#   ✗ 别用 `grep -oE '0x[0-9a-f]+'` ✗ —— ★ 实测它会从几何串 `200x200` 里**匹配出 `0x200`** ✗
#   （★ 前一个 `0` ＋ `x` ＋ `200` ✓）⇒ ★ **子串匹配没有左边界** ✗ ＝ 与 `pgrep` 自匹配同一族 ✓
#   ⇒ ★ 定式：**优选结构（字段/锚定），不选文本子串** ✓
MATCHED=$(echo "$TREE" | command grep -iE "$PAT")
echo "  --- 命中的原行（★ 打印原行，便于看出匹配错没错 ✓）---"
echo "$MATCHED" | sed 's/^/    |/'
# ★★ 再按【几何】筛：★ 只留"真的是画面"的窗口 ✓
#   ✗ 不能只按名字 ✗ —— ★ 实测（2026-10-10，本机 Gazebo ✓）：★ 正则 `gazebo|rviz` 会同时命中
#     ★ `0x600014 "Gazebo GUI"  1x1+0+0` ✗ 与 ★ `0x600004 "Qt Selection Owner…" 3x3+0+0` ✗
#     ⇒ ★ 这两个**截不到** ✓（★ `xwd` 报 `BadMatch (X_GetImage)` ✓ —— ★ 与 `xwd -root` 同一个错 ✓）
#     ⇒ ★★ 于是"退出码 = 0"这条判据**在 Gazebo 正常运行时必然不成立** ✗（★ 不是截图坏了 ✓，★ 是选择器把辅助窗口也算进去了 ✓）
#   ★★ 所以判据改成 ★ **"目标窗口那一张过"** ✓，★ 而**筛选靠结构（几何 ✓），✗ 不靠给名字加排除表** ✗
MINPX="${MIN_PX:-50}"      # ★ 宽与高都要 ≥ 这个值（★ 可用环境变量覆盖 ✓）
IDS=""; SKIPPED=""
while read -r line; do
    [ -n "$line" ] || continue
    id=$(echo "$line" | awk '{print $1}')
    echo "$id" | command grep -qE '^0x[0-9a-f]+$' || continue
    geo=$(echo "$line" | command grep -oE '[0-9]+x[0-9]+\+' | head -1 | sed 's/+$//')  # ★ 只去掉尾部 + ✗ 别 tr 连 x 一起去 ✗
    w=${geo%%x*}; h=${geo##*x}
    if [ -n "$w" ] && [ -n "$h" ] && [ "$w" -ge "$MINPX" ] && [ "$h" -ge "$MINPX" ]; then
        IDS="$IDS $id"
    else
        SKIPPED="$SKIPPED $id(${w:-?}x${h:-?})"
    fi
done <<< "$MATCHED"
IDS=$(echo $IDS | tr ' ' '\n' | sort -u | command grep . || true)
[ -n "$SKIPPED" ] && echo "  ★ 跳过（几何 < ${MINPX}x${MINPX}，★ 不是失败 ✓）：$SKIPPED"
echo "  ★ 目标窗口（几何 ≥ ${MINPX}x${MINPX}）数 = $(printf '%s\n' "$IDS" | command grep -c . || true)"
N=$(printf '%s\n' "$IDS" | command grep -c . || true)
echo "  正则 '$PAT' 命中窗口数 = $N（要求 ≥ $MIN）"

if [ "$N" -lt "$MIN" ]; then
    echo "  ✗ 判据① 不过：窗口数不足"
    echo "    ★ 注意：★「没找到窗口」与「窗口名不叫这个」分不开 ⇒ 先看上面那张窗口全树 ✓"
    exit 1
fi

# ★★ 判据①b【几何互斥】＋ 判据②【内容归属】######################################
#
# ★ 为什么必须加（2026-10-10 实测，reviewer 抓到的 ✗）：
#   ★ WSLg 下 X **不为窗口保留后备存储** ⇒ `xwd -id <窗口>` 拿到的是**屏幕那一块** ✗，
#     ✗ 不是"该窗口自己的渲染内容" ✗。
#   ⇒ ★★ **两窗口一重叠，内容就串** ✗ —— 实测：一张尺寸正是 Gazebo 窗口（1000x845）的图里，
#     同时出现了 **Gazebo 的页脚 `95.46%`** ✓ 和 **RViz 的页脚 `20 fps`** ✗。
#   ⇒ ★★★ 而亮度判据（≥1000）对"**内容错位**"**零分辨力** ✗ —— 它照旧报"过" ✓。
#
# ★ 所以本脚本加两条**结构**判据：
#   ① **几何互斥**：目标窗口的矩形**两两不相交**（相交 ⇒ 直接失败 ✗，✗ 不许静默继续 ✗）
#   ② **内容归属**：每个目标窗口的矩形，**不被任何其它 ≥MINPX 的窗口压住** ✓
#      ⇒ ★★ 在"不相交"这个前提下，`xwd -id` 拿到的**就是它自己的内容** ✓（WSLg 的性质 ✓）
#      ⇒ ★ 两条合起来才答得了"**这张图是谁的画面**" ✓；✗ 单靠亮度答不了 ✗
#   ★ ✗ 不靠"认页脚文字"那种应用特有的记号 ✗ —— ★ 那要按应用维护字样表 ✓，会漂 ✗。
# ──────────────────────────────────────────────────────────────────────────
echo
echo "=== 1b. 几何互斥 ＋ 内容归属（★ 结构判据 ✓）==="
SCREEN_W=$(xdpyinfo 2>/dev/null | awk '/dimensions:/{split($2,d,"x"); print d[1]+0}')
SCREEN_H=$(xdpyinfo 2>/dev/null | awk '/dimensions:/{split($2,d,"x"); print d[2]+0}')

# ★ 窗口树**一次**解析成表：id 缩进 宽 高 绝对X 绝对Y
#   ★ 全部走结构 ✓：缩进＝父子关系 ✓、末尾 `+AX+AY`＝绝对位置 ✓、`WxH`＝尺寸 ✓
#   ✗ 不按名字认窗口 ✗（名字会漂 ✓，而且"排除表"正是 reviewer 明确不要的形态 ✗）
TREE_PARSED=$(xwininfo -root -tree 2>/dev/null | awk '
    $1 ~ /^0x[0-9a-f]+$/ {
        match($0, /^ */); ind = RLENGTH
        w=""; h=""; ax=""; ay=""
        for (i = 2; i <= NF; i++)
            if ($i ~ /^[0-9]+x[0-9]+\+/) { split($i, g, /[x+]/); w = g[1]; h = g[2]; break }
        if (match($0, /\+-?[0-9]+\+-?[0-9]+[ \t]*$/)) {
            s = substr($0, RSTART, RLENGTH); gsub(/[ \t]/, "", s)
            split(s, p, "+"); ax = p[2]; ay = p[3]
        }
        if (w != "" && ax != "") print $1, ind, w, h, ax, ay
    }')

# ★ 父子关系：靠缩进栈推出（✗ 不猜）—— 同一应用的子窗**不算**互相遮挡 ✓
PARENTS=$(printf '%s\n' "$TREE_PARSED" | awk '
    { id[NR] = $1; ind[NR] = $2 }
    END {
        for (i = 1; i <= NR; i++) {
            par = "-"
            for (j = i - 1; j >= 1; j--) if (ind[j] < ind[i]) { par = id[j]; break }
            print id[i], par
        }
    }')
parent_of() { printf '%s\n' "$PARENTS" | awk -v k="$1" '$1 == k { print $2; exit }'; }
# ★ 返回 0 ＝ 两个窗口有**祖孙/父子**关系（同属一个应用 ✓ ⇒ 不算互相遮挡 ✓）
is_related() {
    local a="$1" b="$2" cur
    for cur in "$a" "$b"; do
        local other; [ "$cur" = "$a" ] && other="$b" || other="$a"
        local walk="$cur" guard=0
        while [ "$walk" != "-" ] && [ -n "$walk" ] && [ "$guard" -lt 64 ]; do
            [ "$walk" = "$other" ] && return 0
            walk="$(parent_of "$walk")"; guard=$((guard + 1))
        done
    done
    return 1
}
# ★ 矩形相交（x1 y1 w1 h1 x2 y2 w2 h2）
#   ★ 返回 0＝相交 ✓｜1＝不相交 ✓｜★★ **2＝参数坏了** ✗
#   ★★ 为什么要有 2：实测过一次 —— 字段数对不上时 `$(( $5 + $7 ))` 报
#      `arithmetic syntax error` ✗，而它**退出码非 0** ⇒ 调用方当成"不相交" ⇒ **静默假通过** ✗✗
#      ⇒ ★ 定式：**"算不出来"绝不能落成"没问题"** ✓（与"读空 ⇒ undetermined"✓ 同一条）
rects_overlap() {
    local i v
    for i in 1 2 3 4 5 6 7 8; do
        v="${!i}"
        case "${v}" in
            '' | *[!0-9-]*)
                echo "  ✗ rects_overlap 第 ${i} 个参数不是数值：[${v}] ⇒ ★ 判不了，**不许当成"不相交"** ✗" >&2
                return 2 ;;
        esac
    done
    awk -v a1="$1" -v c1="$2" -v b1="$(($1 + $3))" -v d1="$(($2 + $4))" \
        -v a2="$5" -v c2="$6" -v b2="$(($5 + $7))" -v d2="$(($6 + $8))" \
        'BEGIN{ exit !((a1 < b2) && (a2 < b1) && (c1 < d2) && (c2 < d1)) }'
}

TARGET_RECTS=""
for id in $IDS; do
    line=$(printf '%s\n' "$TREE_PARSED" | awk -v I="$id" '$1 == I { print; exit }')
    if [ -z "$line" ]; then echo "  ✗ $id 在窗口树里取不到几何"; exit 1; fi
    set -- $line; tid="$1"; tw="$3"; th="$4"; tx="$5"; ty="$6"
    TARGET_RECTS="${TARGET_RECTS}${tid} ${tx} ${ty} ${tw} ${th}"$'\n'
    printf '  %s  矩形 [%s,%s]x[%s,%s]（%sx%s @ %s,%s）\n' \
        "$tid" "$tx" "$((tx + tw))" "$ty" "$((ty + th))" "$tw" "$th" "$tx" "$ty"
done

# ① 目标之间两两不相交（★ 同应用的父子跳过 ✓）
GEO_FAIL=0
while read -r id1 x1 y1 w1 h1; do
    [ -n "${id1:-}" ] || continue
    while read -r id2 x2 y2 w2 h2; do
        [ -n "${id2:-}" ] || continue
        [ "$id1" = "$id2" ] && continue
        is_related "$id1" "$id2" && continue
        rects_overlap "$x1" "$y1" "$w1" "$h1" "$x2" "$y2" "$w2" "$h2"; _rc=$?
        if [ "$_rc" -eq 2 ]; then
            echo "  ✗ 判据①b 判不了（$id1 vs $id2 的参数坏了）⇒ ★ 不当成"过" ✗"
            GEO_FAIL=1
        elif [ "$_rc" -eq 0 ]; then
            echo "  ✗ 判据①b 不过：$id1 与 $id2 的矩形**相交** ⇒ 内容会串 ✗"
            GEO_FAIL=1
        fi
    done <<< "$(printf '%s' "$TARGET_RECTS" | grep .)"
done <<< "$(printf '%s' "$TARGET_RECTS" | grep .)"
[ "$GEO_FAIL" -eq 0 ] && echo "  ★ 判据①b 过 ✓：目标窗口矩形**两两不相交** ✓"

# ② 内容归属：目标矩形不被**外来**窗口压住
#    ★ 排除三类（都不是"外来遮挡"✓）：① 自己（同 id ✓）② 同应用的父子窗 ✓ ③ 不在屏内的超大窗口 ✓
#      ★ 第 ③ 类是实测必须的：WSLg 有一个 `8192x8192` 的合成层窗口 ✓ —— 它覆盖全屏、
#        若不排除，**任何截图都会被判失败** ✗ ⇒ 判据恒不通过 ⇒ 又会变成"没人再看它" ✗
OCC_FAIL=0
# ★ 输出列顺序 = 【id x y w h】（★ 与 `read -r oid ox oy ow oh` 对齐 ✓）
#   ✗ 原样 `print`（id ind w h ax ay，6 列）配 5 个变量 ⇒ ay 被粘到 oh 上 ✗
#     ⇒ 报 arithmetic syntax error ✗ ⇒ 调用方误当"不相交" ⇒ **静默假通过** ✗（实测踩到 ✓）
FOREIGN=$(printf '%s\n' "$TREE_PARSED" | awk -v M="$MINPX" -v SW="$SCREEN_W" -v SH="$SCREEN_H" '
    $3 + 0 >= M && $4 + 0 >= M && ($5 + $3) <= SW && ($6 + $4) <= SH { print $1, $5, $6, $3, $4 }')
while read -r tid tx ty tw th; do
    [ -n "${tid:-}" ] || continue
    while read -r oid ox oy ow oh; do
        [ -n "${oid:-}" ] || continue
        [ "$oid" = "$tid" ] && continue
        is_related "$tid" "$oid" && continue
        rects_overlap "$tx" "$ty" "$tw" "$th" "$ox" "$oy" "$ow" "$oh"; _rc=$?
        if [ "$_rc" -eq 2 ]; then
            echo "  ✗ 判据② 判不了（$tid vs $oid 的参数坏了）⇒ ★ 不当成"过" ✗"
            OCC_FAIL=1
        elif [ "$_rc" -eq 0 ]; then
            echo "  ✗ 判据② 不过：$tid 的矩形被外来窗口 $oid 压住 ⇒ 截到的**不是它自己的内容** ✗"
            OCC_FAIL=1
        fi
    done <<< "$(printf '%s' "$FOREIGN" | grep .)"
done <<< "$(printf '%s' "$TARGET_RECTS" | grep .)"
[ "$OCC_FAIL" -eq 0 ] && echo "  ★ 判据② 过 ✓：目标矩形**没有被任何外来窗口压住** ⇒ 截到的就是它自己的内容 ✓"

if [ "$GEO_FAIL" -ne 0 ] || [ "$OCC_FAIL" -ne 0 ]; then
    echo "  ⇒ 先排布再抓：wmctrl -i -r <id> -e 0,X,Y,W,H（★ 实测定式 ✓）；本脚本**拒绝**在串台状态下出图 ✗"
    exit 1
fi

echo
echo "=== 2. 逐个逐窗截图 ＋ ★ 亮度判据 ==="
FAIL=0
for id in $IDS; do
    png="$OUT/win_${id}.png"
    if xwd -id "$id" -out "$OUT/win_${id}.xwd" 2>/dev/null && convert "$OUT/win_${id}.xwd" "$png" 2>/dev/null; then
        read -r W H MEAN < <(identify -format '%w %h %[mean]' "$png" 2>/dev/null; echo)
        OK=$(awk -v m="${MEAN:-0}" -v t="$THRESH" 'BEGIN{print (m>=t)?"YES":"NO"}')
        printf '  %s  %sx%s  mean=%s  ⇒ %s\n' "$id" "${W:-?}" "${H:-?}" "${MEAN:-?}" \
            "$([ "$OK" = YES ] && echo '★ 判据② 过 ✓（不是黑图 ✓）' || echo '✗ 判据② 不过（整张近乎全黑 ✗）')"
        [ "$OK" = YES ] || FAIL=1
        rm -f "$OUT/win_${id}.xwd"
    else
        echo "  $id  ✗ 截图失败"; FAIL=1
    fi
done

echo
echo "=== 3. 小结 ==="
echo "  窗口数 = $N ✓ ｜ 亮度阈值 = $THRESH ｜ 产物目录 = $OUT"
sha256sum "$OUT"/*.png 2>/dev/null | sed 's/^/  /' || true
if [ "$FAIL" -eq 0 ]; then echo "  ⇒ ★ 两条判据都过 ✓"; exit 0; else echo "  ⇒ ✗ 有判据不过"; exit 1; fi
