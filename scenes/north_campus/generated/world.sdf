<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="north_campus">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="dartsim">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.73 0.83 0.90 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 150 0 0 0</pose>
      <diffuse>0.85 0.85 0.80 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>
    <include>
      <uri>model://campus_scene</uri>
    </include>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>30.22413029</latitude_deg>
      <longitude_deg>120.25979315833334</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu" />
    <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat" />
  </world>
</sdf>