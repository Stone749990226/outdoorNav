# RGB-D 仿真二维建图演示的运行环境（aarch64 / Gazebo Sim Fortress）
#
# 与激光版（docker/Dockerfile.arm64）的关系：
#   底图直接复用已构建好的 robonix/slam-demo:humble-arm64（ROS 2 Humble + Gazebo Sim
#   Fortress + ros_gz + RViz + nav2_map_server），这一层只补 RGB-D 建图需要的组件。
#   这样既省构建时间，也保证两套演示的 ROS/Gazebo 版本完全一致。
#
# 与激光版隔离：独立镜像标签、独立容器名、独立 ROS_DOMAIN_ID 与 GZ_PARTITION、
# 独立工作区 rgbd_ws —— 不影响正在运行的激光演示。
ARG BASE_IMAGE=robonix/slam-demo:humble-amd64
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# RTAB-Map（含视觉里程计、同步、可视化、Python 接口）+ 图像工具
#
# 构建期把 ROS 源临时换成国内镜像：rtabmap-ros 会带进 nav2/grid_map/gtsam 等
# 两百多个依赖，直连 packages.ros.org 在这台机器上只有几百 KB/s，装一次要很久。
# 装完立刻换回官方源，镜像里保留的仍是可复现的官方配置。
RUN set -eux; \
    sed -i 's|http://packages.ros.org/ros2/ubuntu|https://mirrors.aliyun.com/ros2/ubuntu|g' \
        /etc/apt/sources.list.d/ros2.list; \
    apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-rtabmap-ros \
        ros-humble-rtabmap-odom \
        ros-humble-rtabmap-sync \
        ros-humble-rtabmap-viz \
        ros-humble-rtabmap-rviz-plugins \
        ros-humble-rtabmap-python \
        ros-humble-image-transport \
        ros-humble-image-transport-plugins \
        ros-humble-image-view \
        ros-humble-cv-bridge \
        ros-humble-tf2-tools; \
    sed -i 's|https://mirrors.aliyun.com/ros2/ubuntu|http://packages.ros.org/ros2/ubuntu|g' \
        /etc/apt/sources.list.d/ros2.list; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /work

# 版本记录（写进 /build-info-rgbd.txt，供 docs/rgbd-environment.md 引用）
RUN { head -2 /etc/os-release; \
      echo "arch:            $(dpkg --print-architecture)"; \
      dpkg-query -W ros-humble-rtabmap-ros ros-humble-rtabmap-odom \
                    ros-humble-rtabmap-sync ros-humble-ros-gz-sim \
                    ros-humble-rviz2 ros-humble-nav2-map-server \
                    ros-humble-image-transport 2>/dev/null \
        | awk '{printf "%-32s %s\n", $1, $2}'; \
    } > /build-info-rgbd.txt && cat /build-info-rgbd.txt
