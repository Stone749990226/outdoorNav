[Unit]
Description=Lynx camera web view (1 fps JPEG over SSH tunnel)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/outdoorNav-git
ExecStart=/usr/bin/python3 %h/outdoorNav-git/tools/camera_view/server.py --config %h/outdoorNav-git/tools/camera_view/config.json
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
