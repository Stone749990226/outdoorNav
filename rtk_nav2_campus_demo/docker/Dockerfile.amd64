# 二维 SLAM 演示运行环境（**x86_64 / amd64，Gazebo Sim Fortress 路线**）
#
# ★ 与 docker/Dockerfile.arm64 的关系：本文件是它**只换架构**的镜像版 ✓ —— 场景语义、包清单、
#   插件、GUI 配置**一字不改** ✓（★ 这正是移植清单 §0 的结论：x86 上 Fortress 也有 amd64 包 ✓）。
#
# ★ 为什么 x86 也走 Fortress，而不是仓库里那支 docker/Dockerfile（x86_64 + Gazebo Classic 11）：
#   ① 与本项目既有成果一致 —— 阶段三~八全部按 Fortress 写成（SDF/插件/launch/ros_gz 桥接）✓；
#   ② 若走 Classic，场景与插件语义都要回改一遍 ✗ ⇒ 那是另一条路线，不是"移植" ✓。
#   ③ ★ 关键：**判断依据不是架构，而是"哪条 Gazebo 路线"** ✗ ——
#      `scripts/lib.sh` 原来用 `uname -m` 选路线 ⇒ 在 x86 上必然选到 Classic ✗
#      （★ 见 build-image.sh 的注释；本机 x86 + Fortress 这个组合历史上不存在 ✓）。
#
# 基础镜像用 ubuntu:22.04：不依赖 Docker Hub 上的 ROS 现成镜像，
# 只依赖三个已验证可达的 apt 源（Ubuntu、packages.ros.org、packages.osrfoundation.org）。
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV TURTLEBOT3_MODEL=burger
ENV LIBGL_ALWAYS_SOFTWARE=0
ENV QT_X11_NO_MITSHM=1
ENV XDG_RUNTIME_DIR=/tmp/runtime-root

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 1) 基础工具与两个官方软件源（ROS 2 Humble / Gazebo Fortress），都是 amd64
#
#    密钥说明（两个坑，都实测过）：
#    - http://packages.ros.org/ros.key 下发的是**已过期**的旧公钥，直接用会让 apt 报
#      EXPKEYSIG 装不了任何 ROS 包；这里改成用构建机上更新过的 keyring
#      （docker/keys/ros-archive-keyring.gpg，由 scripts/build-image.sh 预置）。
#    - http://packages.osrfoundation.org/gazebo.key 是 ASCII-armored 格式，
#      apt 的 signed-by 读不了（会报 NO_PUBKEY），必须先 gpg --dearmor。
COPY docker/keys/ros-archive-keyring.gpg /usr/share/keyrings/ros-archive-keyring.gpg
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg lsb-release ca-certificates locales tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main" \
        > /etc/apt/sources.list.d/ros2.list \
    && curl -fsSL http://packages.osrfoundation.org/gazebo.key \
        | gpg --dearmor > /usr/share/keyrings/osrf-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable jammy main" \
        > /etc/apt/sources.list.d/osrf.list

# 2) ROS 2 Humble 桌面版 + slam_toolbox + Gazebo Sim 桥接 + 地图工具 + 机器人描述
# ★★ 2026-10-12 补：**整个 nav2 栈**（原来只装了 nav2-map-server ✗ ⇒ 工作区里
#   `find_package(nav2_costmap_2d)` 找不到 ⇒ colcon build 直接失败 ✗；
#   实测：参照机 1815 个包、只装 map-server 时 1718 ✗ ⇒ 差 97 个、其中 nav2 相关 26 个 ✓）
#   并补 robot_localization（栈里 ekf/navsat_transform 用 ✓）、depth_image_proc（相机链用 ✓）
#   与 nav2/slam 的**构建期依赖**（那几个 -dev/lib ✗ —— ★ 它们不会由 `apt install navigation2` 带出来 ✓）
#   ★ 判据：装完 `dpkg-query` 应回到 **1815** 个包、与 docs/image/dpkg-versions.txt 的 diff 为空 ✓
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-desktop \
        ros-humble-slam-toolbox \
        ros-humble-ros-gz \
        ros-humble-ros-gz-sim \
        ros-humble-ros-gz-bridge \
        ros-humble-turtlebot3-description \
        ros-humble-turtlebot3-teleop \
        ros-humble-nav2-map-server \
        ros-humble-navigation2 \
        ros-humble-nav2-bringup \
        ros-humble-robot-localization \
        ros-humble-depth-image-proc \
        ros-humble-rtabmap-ros \
        ros-humble-grid-map-ros \
        ros-humble-pcl-ros \
        ros-humble-imu-filter-madgwick \
        ros-humble-image-view \
        ros-humble-camera-calibration-parsers \
        ros-humble-filters \
        ros-humble-geographic-msgs \
        ros-humble-octomap-msgs \
        ros-humble-apriltag-msgs \
        ros-humble-aruco-msgs \
        ros-humble-aruco-opencv-msgs \
        libbenchmark-dev \
        libgeographic-dev \
        libglfw3-dev \
        libnanoflann-dev \
        libncurses-dev \
        libomp-dev \
        libpcap0.8-dev \
        libxtensor-dev \
        nlohmann-json3-dev \
        ros-humble-teleop-twist-keyboard \
        ros-humble-tf2-tools \
        ros-humble-robot-state-publisher \
        ros-humble-xacro \
        python3-pytest \
        python3-yaml \
        python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# 3) Gazebo Sim（Fortress）：与 ROS 2 Humble 的 ros_gz 配套
RUN apt-get update && apt-get install -y --no-install-recommends \
        ignition-fortress \
        libignition-gazebo6-dev \
    && rm -rf /var/lib/apt/lists/*

# 4) 图形与窗口管理工具（远程桌面里显示与截图诊断用）
RUN apt-get update && apt-get install -y --no-install-recommends \
        mesa-utils \
        libgl1-mesa-dri \
        libglu1-mesa \
        x11-utils \
        x11-xserver-utils \
        xdotool \
        wmctrl \
    && rm -rf /var/lib/apt/lists/*

# 预置 Gazebo Sim GUI 的完整配置（含 Scene 等插件）。
# 踩过的坑：如果这个文件缺失或被写成一个只有 <window> 的空壳，
# GUI 启动后只会显示 "Insert plugins to start!"，3D 视口完全不渲染。
# 这份是从一次正常运行的 GUI 里导出的默认配置，scripts/container/prepare_gui_layout.sh
# 只会在它基础上改窗口几何，不会再凭空造文件。
COPY docker/gz-gui/gui.config /root/.ignition/gazebo/6/gui.config

RUN printf '%s\n' \
    'source /opt/ros/humble/setup.bash' \
    '[ -f /work/demo_ws/install/setup.bash ] && source /work/demo_ws/install/setup.bash' \
    'cd /work/demo_ws 2>/dev/null || true' \
    > /root/.bashrc_ros

WORKDIR /work

COPY docker/build_info.sh /usr/local/bin/build_info.sh
RUN bash /usr/local/bin/build_info.sh > /build-info.txt && cat /build-info.txt

# ★★ 2026-10-13：node ＋ 前端 dev server —— ★ 让"一条命令起完"成立 ★★
#   ★ 业主原话 ✓："**怎么还要在 windows 和 wsl 之间切换** ✓ —— 我想起完 `frontend-bridge.sh`
#     就能直接访问" ✓ ⇒ ★ 前端在**容器里**跑 ✓ ⇒ ★ 容器是 `--network host` ✓ ⇒
#     ★ WSL 侧与 Windows 侧**都能**开 `localhost:5173` ✓ ⇒ ★ 全程不进 Windows ✓
#   ★ ★ **为什么不用 apt** ✗（实测 ✓）：★ 底图是 Ubuntu 22.04 ✓ ⇒ `apt-cache policy nodejs`
#     ⇒ ★ **Candidate 12.22.9** ✗ ⇒ ★ 而 `vite 6.4.3`（★ 它 `package.json` 里声明的 ✓）
#     要 ★ **`^18 || ^20 || >=22`** ✗ ⇒ ★ **apt 给不了** ✗
#   ★ ★ **为什么不用 NodeSource** ✗：★ 那要**再引一个 apt 源** ✗ ⇒ ★ 版本与源都多一处
#     不确定 ✓ ⇒ ★ 改用**官方预编译包 ＋ 钉版本 ＋ 校验 sha256** ✓（★ 与各 Dockerfile
#     "版本按号钉死"的既有做法一致 ✓）
#   ★ ★ **为什么 `npm ci` 而不是 `npm install`** ✓：★ 仓里有 `package-lock.json` ✓（76168 字节 ✓）
#     ⇒ ★ lock 才可复现 ✓（★ 与"版本按号钉死"同一个理由 ✓）
#   ★ ★ **为什么放在**构建时**装** ✗ 不放到首次运行 ✗：★ 首次运行装 ⇒ ★ 起栈要多等几分钟
#     ＋ 要联网 ✗ ⇒ ★ **"一条命令"就不成立** ✗
#   ★ ★ npm 源换国内镜像 ✓ —— ★ 与各 Dockerfile 里"apt 换阿里源"**同一个理由** ✓
#     （★ 这台机器上 packages.ros.org 只有几百 KB/s ✓）
#   ★ ★ 前端源码**按他们的原路径** ✓（`outdoor-patrol-demo/` ✓）—— ✗ 不塞进 `.external` ✗：
#     ★ 并入他们仓之后那份**本来就在仓里** ✓ ⇒ ★ 同路径 ⇒ ★ 将来是**同一份覆盖** ✓
#     ✗ 不产生第二份 ✗（★ "两份一模一样＝即将不一样" ✓）
ARG NODE_VERSION=22.11.0
ARG NODE_SHA256=83bf07dd343002a26211cf1fcd46a9d9534219aad42ee02847816940bf610a72
RUN set -eux; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        -o /tmp/node.tar.xz; \
    echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    node -v; npm -v

COPY outdoor-patrol-demo /opt/outdoor-patrol-demo
RUN set -eux; \
    cd /opt/outdoor-patrol-demo; \
    npm ci --registry=https://registry.npmmirror.com; \
    test -x node_modules/.bin/vite; \
    ls -d node_modules >/dev/null
