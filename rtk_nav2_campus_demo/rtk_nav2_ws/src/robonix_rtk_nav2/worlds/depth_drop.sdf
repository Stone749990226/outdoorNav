<?xml version="1.0" ?>
<!-- Stage 6: two separately supported floor slabs, not a painted step on continuous ground.
     Upper surface z=0, lower surface z=-0.30, edge x=0, width y=+-3 m.
     The robot is spawned on the upper slab at x=-2.3; no slab spans the drop. -->
<sdf version="1.9">
  <world name="depth_drop">
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>31.2304</latitude_deg>
      <longitude_deg>121.4737</longitude_deg>
      <elevation>4.0</elevation>
    </spherical_coordinates>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.3 -1</direction>
    </light>
    <model name="upper_platform">
      <static>true</static>
      <pose>-2 0 -0.10 0 0 0</pose>
      <link name="slab">
        <collision name="collision"><geometry><box><size>4 6 0.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 6 0.20</size></box></geometry>
          <material><ambient>0.25 0.65 0.48 1</ambient><diffuse>0.25 0.65 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="lower_platform">
      <static>true</static>
      <pose>4 0 -0.40 0 0 0</pose>
      <link name="slab">
        <collision name="collision"><geometry><box><size>8 6 0.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 6 0.20</size></box></geometry>
          <material><ambient>0.30 0.40 0.76 1</ambient><diffuse>0.30 0.40 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
