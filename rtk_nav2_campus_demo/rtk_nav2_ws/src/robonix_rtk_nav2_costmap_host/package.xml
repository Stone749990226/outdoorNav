<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robonix_rtk_nav2_costmap_host</name>
  <version>0.1.0</version>
  <description>
    RTK 第三阶段：自写的局部代价地图宿主。只把生命周期转发给 Costmap2DROS("local_costmap")，
    没有任何控制输出（替代 nav2 的 controller_server，理由见 docs/rtk-nav2-brief.md §10 裁定 2）。
  </description>
  <maintainer email="xjy@example.com">robonix</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
