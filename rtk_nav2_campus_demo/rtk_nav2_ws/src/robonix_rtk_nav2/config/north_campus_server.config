<?xml version="1.0"?>
<!--
  ★ 阶段九：给 `north_campus.sdf` 用的**服务端配置**（Fortress 的 systems 插件表 ✓）

  ★★ 为什么需要它（2026-10-10 实测得到的真因 ✓）★★
    · 他们的 `campus.world` 是给 **Gazebo Classic** 写的 ✓ —— 里面**一个 `<plugin>` 都没有** ✗
      （Classic 的传感器由它自己的渲染管线管，不需要 SDF 里声明系统插件 ✓）。
    · 而 **Fortress 必须**在世界里（或服务端配置里）声明系统插件才有对应能力 ✗ ——
      实测现象：车在、世界在、`ign model --list` 也能看到 `robot_rtk` ✓，
      ★ 但 **gz 侧一个传感器话题都没有** ✗（`ign topic -l | grep navsat` = 空 ✓）
      ⇒ 相机/激光/GPS **全都不出数据** ✗ ⇒ `/rtk/navsat` 无值 ⇒ `navsat_transform` 无输出
      ⇒ `absolute_localizer` 报 `no_fix` ✗ ⇒ **没有 map 帧** ⇒ nav2 起不来 ✗
      ⇒ 就绪闸门一直等 ✗（★ 现象是"卡在起栈"，其实根子在**世界没声明系统插件** ✓）。
    · ★ 对照：我们自己的 `campus_100.sdf` **有**这六个插件 ✓（`make_campus_world.py` 生成的 ✓）
      ⇒ 同一套 launch/车/参数在那边正常 ✓ ⇒ 差别就在这份插件表 ✓。

  ★★ 为什么用**服务端配置**而不是改世界文件 ✓ ★★
    · `ign gazebo` 支持 `IGN_GAZEBO_SERVER_CONFIG_PATH` / `GZ_SIM_SERVER_CONFIG_PATH`
      ⇒ **运行层**给插件表 ✓ ⇒ **世界文件一个字节不动** ✓
      （与第 2 步那两处渲染层补偿、以及球坐标的运行时服务，同属"运行期参数" ✓，单独记账 ✓）。
    · ★ 但它是**替换**而不是追加 ✗ —— 不写默认那三个就会丢掉物理/命令/场景广播 ✓
      ⇒ 所以这里把**默认的三个也一并写上** ✓（= 默认表 **＋** 传感器那三个 ✓）。

  ★ 六个插件的来历 = 逐条抄 `campus_100.sdf` 里那一组 ✓（顺序与写法都照抄 ✓）。
-->
<server_config>
  <plugins>
    <!-- ↓ 默认表里就有的三个（✗ 不写会丢 ✗） -->
    <plugin entity_name="*"
            entity_type="world"
            filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin entity_name="*"
            entity_type="world"
            filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin entity_name="*"
            entity_type="world"
            filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- ↓ 默认表里**没有**的三个（★ 本步要补的就是它们 ✓） -->
    <!-- 没有这个插件，相机/激光一个都不会出数据 -->
    <plugin entity_name="*"
            entity_type="world"
            filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU 与 GPS（navsat）各自需要自己的系统插件：它们不属于 Sensors 系统 -->
    <plugin entity_name="*"
            entity_type="world"
            filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu">
    </plugin>
    <plugin entity_name="*"
            entity_type="world"
            filename="ignition-gazebo-navsat-system"
            name="ignition::gazebo::systems::NavSat">
    </plugin>
  </plugins>
</server_config>
