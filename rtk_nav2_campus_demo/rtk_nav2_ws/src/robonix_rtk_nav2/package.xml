<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robonix_rtk_nav2</name>
  <version>0.1.0</version>
  <description>RTK 第三阶段：复用 nav2 costmap_2d 建图（全局累积 + 局部滚动）与 NavFn 规划</description>
  <maintainer email="xjy@example.com">robonix</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- 第二阶段链路：定位 -->
  <depend>robot_localization</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <!-- 第三阶段新增：相机深度 -> 点云（brief §2 指定，不再自写反投影） -->
  <depend>depth_image_proc</depend>
  <!-- nav2 两张图的宿主与规划器（局部图宿主是本仓库自写的 C++ 包，
       见 robonix_rtk_nav2_costmap_host；全局图由 planner_server 承载） -->
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_navfn_planner</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
