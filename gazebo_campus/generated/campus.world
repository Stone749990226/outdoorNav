<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="north_campus">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.73 0.83 0.90 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 150 0 0 0</pose>
      <diffuse>0.85 0.85 0.80 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>
    <include>
      <uri>model://campus_scene</uri>
    </include>
    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>210 -255 195 0 0.60 2.22</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so" />
  </world>
</sdf>