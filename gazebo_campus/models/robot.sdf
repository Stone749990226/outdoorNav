<?xml version="1.0"?>
<sdf version="1.6">
  <model name="campus_robot">
    <link name="base_link">
      <pose>0 0 0.22 0 0 0</pose>
      <inertial><mass>18</mass><inertia><ixx>0.38</ixx><iyy>0.68</iyy><izz>0.94</izz></inertia></inertial>
      <collision name="body_collision"><geometry><box><size>0.65 0.45 0.22</size></box></geometry></collision>
      <visual name="body"><geometry><box><size>0.65 0.45 0.22</size></box></geometry><material><ambient>0.05 0.45 0.65 1</ambient><diffuse>0.05 0.45 0.65 1</diffuse></material></visual>
      <visual name="front"><pose>0.33 0 0.02 0 0 0</pose><geometry><box><size>0.02 0.28 0.07</size></box></geometry><material><ambient>1 0.8 0.1 1</ambient><diffuse>1 0.8 0.1 1</diffuse></material></visual>
      <sensor name="bumper" type="contact"><always_on>true</always_on><update_rate>20</update_rate><contact><collision>body_collision</collision></contact><plugin name="bumper" filename="libgazebo_ros_bumper.so"><ros><remapping>bumper_states:=/campus/contacts</remapping></ros><frame_name>base_link</frame_name></plugin></sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.29 0.12 1.57079632679 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.0072</izz></inertia></inertial>
      <collision name="wheel"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="wheel"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.29 0.12 1.57079632679 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.0072</izz></inertia></inertial>
      <collision name="wheel"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="wheel"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <joint name="left_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="right_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <link name="front_caster">
      <pose>0.25 0 0.06 0 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia></inertial>
      <collision name="caster"><geometry><sphere><radius>0.06</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <visual name="caster"><geometry><sphere><radius>0.06</radius></sphere></geometry></visual>
    </link>
    <joint name="front_caster_fixed" type="fixed"><parent>base_link</parent><child>front_caster</child></joint>
    <link name="rear_caster">
      <pose>-0.25 0 0.06 0 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia></inertial>
      <collision name="caster"><geometry><sphere><radius>0.06</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <visual name="caster"><geometry><sphere><radius>0.06</radius></sphere></geometry></visual>
    </link>
    <joint name="rear_caster_fixed" type="fixed"><parent>base_link</parent><child>rear_caster</child></joint>
    <link name="laser">
      <pose>0.1 0 0.40 0 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="laser"><geometry><cylinder><radius>0.055</radius><length>0.08</length></cylinder></geometry><material><ambient>0.9 0.25 0.12 1</ambient><diffuse>0.9 0.25 0.12 1</diffuse></material></visual>
      <sensor name="laser" type="ray"><always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
        <ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan><range><min>0.12</min><max>35</max><resolution>0.01</resolution></range></ray>
        <plugin name="laser" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=/campus/raw_scan</remapping><qos><topic name="/campus/raw_scan"><publisher><reliability>best_effort</reliability><history depth="5">keep_last</history></publisher></topic></qos></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>laser</frame_name></plugin>
      </sensor>
    </link>
    <joint name="laser_fixed" type="fixed"><parent>base_link</parent><child>laser</child></joint>
    <plugin name="drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate><left_joint>left_joint</left_joint><right_joint>right_joint</right_joint>
      <wheel_separation>0.58</wheel_separation><wheel_diameter>0.24</wheel_diameter><max_wheel_torque>20</max_wheel_torque><max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic><publish_odom>false</publish_odom><publish_odom_tf>false</publish_odom_tf><publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
    <plugin name="ideal_pose" filename="libgazebo_ros_p3d.so"><ros><remapping>odom:=/campus/ground_truth</remapping></ros><body_name>base_link</body_name><frame_name>world</frame_name><update_rate>30</update_rate><gaussian_noise>0</gaussian_noise></plugin>
  </model>
</sdf>
