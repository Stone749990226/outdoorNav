# Per-task session output dumped under artifacts/ (e.g. simulation-20261111/).
/artifacts/*-20[0-9][0-9][0-9][0-9][0-9][0-9]/
/integrations/robonix_outdoor/rbnx-build/
**/*.tsbuildinfo

# Field demo runtime output
/run/

# Local runtime output
/logs/
