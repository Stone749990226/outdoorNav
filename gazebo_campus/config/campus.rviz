Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Background Color: 35; 43; 48
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Name: 3D campus
    Enabled: true
    Topic:
      Value: /campus/scene
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Temporary obstacles
    Enabled: true
    Topic:
      Value: /campus/test_obstacles
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/Grid
    Name: Metric grid
    Enabled: false
    Cell Size: 10
    Plane Cell Count: 30
    Color: 75; 85; 90
  - Class: rviz_default_plugins/Map
    Name: Traversable map
    Enabled: false
    Alpha: 0.8
    Draw Behind: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Map
    Name: Global costs
    Enabled: false
    Alpha: 0.5
    Color Scheme: costmap
    Topic:
      Value: /global_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
  - Class: rviz_default_plugins/RobotModel
    Name: Robot
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
  - Class: rviz_default_plugins/LaserScan
    Name: Laser
    Enabled: true
    Size (m): 0.08
    Style: Points
    Color: 255; 90; 75
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
  - Class: rviz_default_plugins/Path
    Name: Planned path
    Enabled: true
    Color: 30; 210; 255
    Line Style: Lines
    Line Width: 0.15
    Topic:
      Value: /plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Raw measured traces
    Enabled: true
    Topic:
      Value: /campus/traces/raw
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Filtered traces
    Enabled: false
    Topic:
      Value: /campus/traces/filtered
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Original road network
    Enabled: false
    Topic:
      Value: /campus/traces/network
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D campus overview
      Distance: 240
      Focal Point:
        X: 49
        Y: -38
        Z: 25
      Pitch: 0.6
      Yaw: 5.3
      Near Clip Distance: 0.1
Window Geometry:
  Width: 1280
  Height: 900
